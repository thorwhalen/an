# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class


.DS_Store
# C extensions
*.so

# TLS certificates
## Ignore all PEM files anywhere
*.pem
## Also ignore any certs directory
certs/

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
_build

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.pytest_cache/

# Translations
*.mo
*.pot

# Django stuff:
*.log
local_settings.py
db.sqlite3

# Flask stuff:
instance/
.webassets-cache

# Scrapy stuff:
.scrapy

# Sphinx documentation
docs/_build/
docs/*

# PyBuilder
target/

# Jupyter Notebook
.ipynb_checkpoints

# pyenv
.python-version

# celery beat schedule file
celerybeat-schedule

# SageMath parsed files
*.sage.py

# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Spyder project settings
.spyderproject
.spyproject

# Rope project settings
.ropeproject

# mkdocs documentation
/site

# mypy
.mypy_cache/

# PyCharm
.idea

# an per-project ephemera (renders, intermediates, agent state)
examples/*/output/
examples/*/artifacts/
examples/*/assets/
examples/*/.an/
examples/*/.anima/
examples/*/an.toml
examples/*/anima.toml

# The promote_demo example's input SVG is the whole point of the example
# — keep it tracked even though examples/*/assets/ is otherwise ignored.
!examples/promote_demo/assets/
!examples/promote_demo/assets/characters/
!examples/promote_demo/assets/characters/raw_maya/
!examples/promote_demo/assets/characters/raw_maya/*.svg
# But re-exclude the promote target — it's regenerated by build.py.
examples/promote_demo/assets/characters/maya-promoted/

# Agent worktrees (adversarial reviewers run isolated here so they cannot
# mutate the shared checkout). Never committed, and excluded from tooling
# below or ruff/pytest walk three extra copies of the whole repo.
.claude/worktrees/

# Session-boundary handoffs. Local working notes, not project docs — anything
# that should outlive a session belongs in an issue or misc/docs/ instead.
.claude/handoffs/
